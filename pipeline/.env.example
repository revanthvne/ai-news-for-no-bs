# ─────────────────────────────────────────────────────────────
# NO BS — Daily AI Short pipeline configuration
# Copy this file to `.env` and fill in what you have.
# EVERYTHING here is OPTIONAL. With zero keys the pipeline still
# runs in "seed/offline" mode and produces a full edition + email.
# ─────────────────────────────────────────────────────────────

# --- AI synthesis (pick ONE; all have generous free tiers) ---
# Groq is free + fast. Get a key at https://console.groq.com
LLM_PROVIDER=groq                 # groq | openai | anthropic | none
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile # groq default; use gpt-4o-mini / claude-3-5-haiku for others

# --- Email delivery (pick ONE) ---
# Resend has a free tier (3,000 emails/mo). https://resend.com
EMAIL_PROVIDER=resend             # resend | smtp | none
RESEND_API_KEY=
EMAIL_FROM=NO BS Daily <daily@yourdomain.com>
APPROVER_EMAIL=you@example.com          # where APPROVAL REQUIRED emails go (set your address)
EMAIL_MODE=compact                      # compact = small, Gmail-safe email; full = inline every deep-dive

# If you use plain SMTP (e.g. Gmail app password) instead of Resend:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Optional: news enrichment (free tiers exist) ---
NEWSAPI_KEY=                      # https://newsapi.org (optional)
GITHUB_TOKEN=                     # raises GitHub API rate limits (optional)

# --- Optional: Supabase (free tier) for web + mobile apps ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Approval webhook (the web app exposes this) ---
APPROVE_BASE_URL=http://localhost:3000
